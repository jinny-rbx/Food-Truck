            <ui:VisualElement name="HealthBarFill" class="healthbar-size" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/DiddyTruck&apos;s%20Asset/Art/2D%20Art/UI/HealthBarFill.png?fileID=2800000&amp;guid=53c14fcd0b739564aa1909175e09fc6f&amp;type=3#HealthBarFill&quot;); position: absolute; height: 100%; overflow: visible; width: 1050px;"/>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="EnergyBarBackground" style="flex-grow: 1; position: absolute; height: 85px; background-image: url(&quot;project://database/Assets/DiddyTruck&apos;s%20Asset/Art/2D%20Art/UI/FoodBarBackground.png?fileID=2800000&amp;guid=0efa650678e918044b72c32bb582cd82&amp;type=3#FoodBarBackground&quot;); top: 145px; left: 14px; right: auto; bottom: 695px; width: 400px;">
