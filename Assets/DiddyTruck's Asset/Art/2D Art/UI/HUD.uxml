    <ui:VisualElement name="HealthBarBackground" class="healthbar-size" style="flex-grow: 1; position: absolute; height: 150px; background-image: url(&quot;project://database/Assets/DiddyTruck&apos;s%20Asset/Art/2D%20Art/UI/HealthbarBackground.png?fileID=2800000&amp;guid=3abdeb566e966974fb7039785261b1a5&amp;type=3#HealthbarBackground&quot;); width: 1050px;">
